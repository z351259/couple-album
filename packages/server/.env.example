# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DATABASE_URL="postgresql://couple:couple123@localhost:5432/couple_album"

# Redis 配置
REDIS_URL="redis://localhost:6379"

# JWT 密钥
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 上传配置
UPLOAD_DIR="../../uploads"
MAX_FILE_SIZE=52428800

# 图片压缩配置（4K分辨率）
MAX_WIDTH=3840
MAX_HEIGHT=2160
